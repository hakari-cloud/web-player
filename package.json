{
  "name": "@hakari/player",
  "version": "0.1.0",
  "description": "Embed-friendly HLS / LL-HLS player for Hakari live streams and VODs.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup && tsup --config tsup.embed.config.ts",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "example": "vite examples"
  },
  "dependencies": {
    "hls.js": "^1.6.16"
  },
  "devDependencies": {
    "tsup": "^8.5.0",
    "typescript": "^5.4.0",
    "vite": "^5.4.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/PiratedKukreja/hakari-player.git"
  },
  "homepage": "https://hakari.cloud",
  "keywords": [
    "hls",
    "llhls",
    "low-latency",
    "video",
    "player",
    "streaming",
    "hakari"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=18"
  }
}
