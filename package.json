{
  "name": "@hakari/web-player",
  "version": "0.1.1",
  "description": "Embed-friendly HLS / LL-HLS web player for Hakari live streams and VODs. Custom controls, sprite-thumbnail scrubbing, signed-playback aware.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js",
      "require": "./dist/react.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup && tsup --config tsup.embed.config.ts",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "example": "vite examples",
    "example:react": "vite examples/react"
  },
  "dependencies": {
    "hls.js": "^1.6.16"
  },
  "peerDependencies": {
    "react": ">=17",
    "react-dom": ">=17"
  },
  "peerDependenciesMeta": {
    "react": { "optional": true },
    "react-dom": { "optional": true }
  },
  "devDependencies": {
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "tsup": "^8.5.0",
    "typescript": "^5.4.0",
    "vite": "^5.4.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hakari-cloud/web-player.git"
  },
  "homepage": "https://hakari.cloud",
  "bugs": {
    "url": "https://github.com/hakari-cloud/web-player/issues"
  },
  "keywords": [
    "hls",
    "llhls",
    "low-latency",
    "video",
    "player",
    "streaming",
    "hakari"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=18"
  }
}
